# 复制为 .env 后填写。真实账号、密码、Cookie 和 Key 只放 .env，不提交到 Git。
# JSON 必须在同一行；不要在值后追加注释。环境变量优先于此文件。

# 服务与存储（留空 DATA_DIR 使用项目 data/）
HOST=127.0.0.1
PORT=3081
DATA_DIR=
# 默认读取项目 .env；可在启动前通过环境变量切换配置文件
# XMONITOR_ENV_FILE=/absolute/path/to/.env

# LLM：OpenAI 兼容接口
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_REQUIRE_KEY=true
ANALYZE_THRESHOLD=60

# X：公开监控对象不是登录账号；真实登录账号配置在 X_ACCOUNTS_JSON
MONITOR_ACCOUNTS=karpathy,sama,ylecun,AndrewYNg,OpenAI,GoogleDeepMind,AnthropicAI,huggingface
SCRAPE_MODE=auto
SCRAPE_INTERVAL_MIN=30
SCRAPE_PER_ACCOUNT=10
X_PROXY=
PYTHON_BIN=
# [] 为不配置登录账号；支持多个账号，Cookie 与密码二选一
# 结构示例见 docs/security/env-configuration.md，勿在此模板填写真实信息
X_ACCOUNTS_JSON=[]

# 采集认证：来源 URL 优先于平台默认值；界面新增/保存/清除认证同步写回 .env
# 支持 cookie/token/bearer/api_key/basic/headers/fields，格式见配置说明
COLLECTOR_AUTH_JSON={"sources":{},"platforms":{}}
# 64 位十六进制主密钥；已有数据迁移时必须沿用原 data/.collector-key，不能随意更换
COLLECTOR_MASTER_KEY=
COLLECTOR_PROXY=

# 默认来源、同步与分页
WEB_DEFAULT_KEYWORDS=
WEB_COLLECT_INTERVAL_MIN=360
WEB_MAX_ITEMS_PER_KEYWORD=100
HF_BASE_URL=https://huggingface.co
HF_SYNC_ENABLED=true
HF_SYNC_INTERVAL_HOURS=24
HF_PAGE_SIZE=100
HF_MAX_PAGES_PER_RUN=0
ARXIV_MAX_RESULTS=100
FORUM_MAX_ITEMS=100
GOOGLE_CSE_CX=

# HTTP 与内核调度（按需调整；0 上限按对应功能说明解释）
COLLECTOR_TIMEOUT_MS=30000
COLLECTOR_RETRIES=2
COLLECTOR_CONCURRENCY=3
COLLECTOR_MAX_ATTEMPTS=3
COLLECTOR_RETRY_BASE_MS=2000
COLLECTOR_RETRY_MAX_MS=300000
COLLECTOR_LEASE_MS=120000
COLLECTOR_JOB_TIMEOUT_MS=600000
COLLECTOR_PLAN_INTERVAL_SECONDS=15
# 旧轮询兼容项，留空使用上述秒级规划间隔
# COLLECTOR_POLL_INTERVAL_MIN=1
COLLECTOR_MAX_RESPONSE_BYTES=8388608
COLLECTOR_JOB_RETENTION_DAYS=30
COLLECTOR_WORKER_ID=
COLLECTOR_DEFAULT_MAX_ITEMS=100
COLLECTOR_NOTIFICATION_RETENTION_DAYS=30
COLLECTOR_WEB_CRAWL_DELAY_MS=1000
